# ─────────────────────────────────────────────────────────────
# Instagram Search — environment variable reference
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real secrets.
# ─────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────
# From: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# Service role key — server-only, NEVER expose to the browser
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ── Stripe ───────────────────────────────────────────────────
# From: Stripe dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price ID of the subscription plan (create in Stripe dashboard)
STRIPE_PRICE_ID=price_...

# Your app's public URL — used for Stripe redirect URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Instagram session encryption ─────────────────────────────
# 32-byte (256-bit) AES-GCM key, base64-encoded.
# Generate with: openssl rand -base64 32
IG_SESSION_ENCRYPTION_KEY=<base64-encoded-32-byte-key>
